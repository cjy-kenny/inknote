{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InkNote",
  "version": "0.1.0",
  "identifier": "com.inknote.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "InkNote",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "InkNote",
    "copyright": "Copyright © 2026 InkNote",
    "category": "Productivity",
    "shortDescription": "一个安静的本地 Markdown 记事本。",
    "longDescription": "InkNote 是一个完全本地的 Markdown 记事本：没有账号、没有同步、没有遥测。正文是普通文件，搜索索引保存在本机 SQLite 中，可随时带走。",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
