{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "InkNote main window capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "dialog:default",
    "opener:default"
  ]
}
